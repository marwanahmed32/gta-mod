// GTA V v1.27 Custom Payload - Square + R1 Combo Trigger
#include <stdint.h>

// Car Hashes for GTA V v1.27
// 1. BMW X5 (Rebla GTS)       -> 0xCE8259CD
// 2. G Class (Dubsta3)         -> 0x77062402
// 3. Renault Logan (Asea)      -> 0x3231D1C5
// 4. Shase (Rebel)             -> 0x815E7C74
// 5. Maybach GLS (XLS)         -> 0x12760C50

// Trigger Combo Check: BUTTON_SQUARE + BUTTON_R1
bool CheckMenuCombo() {
    return IsButtonPressed(BUTTON_SQUARE) && IsButtonPressed(BUTTON_R1);
}

// Super Speed & Engine Multiplier Applied on Spawn
void ApplySuperSpeed(Vehicle veh) {
    SET_VEHICLE_ENGINE_POWER_MULTIPLIER(veh, 50.0f);
    SET_VEHICLE_MAX_SPEED(veh, 1000.0f);
}
